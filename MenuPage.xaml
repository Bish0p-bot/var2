      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Меню">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Вариант №6" FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnTask1" Content="Задача 1" Width="160" Height="50"
                        FontSize="18" Margin="10" Click="btnTask1_Click"/>
                <Button x:Name="btnTask2" Content="Задача 2" Width="160" Height="50"
                        FontSize="18" Margin="10" Click="btnTask2_Click"/>
