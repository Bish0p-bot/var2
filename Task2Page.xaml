<Page x:Class="Student_Variant6.Pages.Task2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 2">
    <Grid Margin="30,20">
        <StackPanel>
            <TextBlock Text="Задача 2. Работа со строками" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20"
                       Text="Дана строка, содержащая несколько круглых скобок. Если скобки расставлены правильно (то есть каждой открывающей соответствует одна закрывающая), то вывести число 0. В противном случае вывести или номер позиции, в которой расположена первая ошибочная закрывающая скобка, или, если закрывающих скобок не хватает, число –1."/>

            <TextBlock Text="Строка:" FontSize="16"/>
            <TextBox x:Name="txtInput" FontSize="16" Height="30" Margin="0,5,0,15"/>

            <Button x:Name="btnCheck" Content="Выполнить" Width="140" Height="35"
                    FontSize="16" HorizontalAlignment="Left" Click="btnCheck_Click"/>

            <TextBlock Text="Результат:" FontSize="16" Margin="0,20,0,0"/>
            <TextBox x:Name="txtResult" FontSize="16" Height="30" Margin="0,5,0,0" IsReadOnly="True"/>
        </StackPanel>
    </Grid>
</Page>
