<Window x:Class="Student_Variant6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическое занятие — Вариант 6" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна -->
        <Grid Grid.Row="0" Background="#FF76E383">
            <TextBlock Text="Вариант №6" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
            <Button x:Name="btnBack" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="90" Height="32" Margin="0,0,15,0"
                    Content="Назад" Click="btnBack_Click"/>
        </Grid>

        <!-- Frame отображает страницы из папки Pages -->
        <Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden"
               ContentRendered="FrmMain_ContentRendered"/>
    </Grid>
</Window>
