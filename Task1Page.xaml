<Page x:Class="Student_Variant6.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 1">
    <Grid Margin="30,20">
        <StackPanel>
            <TextBlock Text="Задача 1. Работа с числами" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20"
                       Text="Дан номер некоторого года (положительное целое число). Вывести соответствующий ему номер столетия, учитывая, что, к примеру, началом 20 столетия был 1901 год."/>

            <TextBlock Text="Номер года:" FontSize="16"/>
            <TextBox x:Name="txtYear" FontSize="16" Height="30" Margin="0,5,0,15"
                     PreviewTextInput="txtYear_PreviewTextInput"/>

            <Button x:Name="btnCalculate" Content="Выполнить" Width="140" Height="35"
                    FontSize="16" HorizontalAlignment="Left" Click="btnCalculate_Click"/>

            <TextBlock Text="Результат:" FontSize="16" Margin="0,20,0,0"/>
            <TextBox x:Name="txtResult" FontSize="16" Height="30" Margin="0,5,0,0" IsReadOnly="True"/>
        </StackPanel>
    </Grid>
</Page>
